# Jade Fleet vision service settings (installed as /etc/jade-fleet/vision.env)
JADE_VISION_PORT=8090
JADE_VISION_YOLO=/opt/jade-vision/engines/yolov8n_dla0_fp16.engine
JADE_VISION_YOLO_DLA=0
JADE_VISION_YOLO_LABELS=/opt/jade-vision/models/coco.names
JADE_VISION_MOBILENET=/opt/jade-vision/engines/mobilenet_v2_dla1_fp16.engine
JADE_VISION_MOBILENET_DLA=1
JADE_VISION_MOBILENET_LABELS=/opt/jade-vision/models/imagenet.names
# Optional bearer token; leave empty when only the OptiPlex can reach this port
#JADE_VISION_TOKEN=
