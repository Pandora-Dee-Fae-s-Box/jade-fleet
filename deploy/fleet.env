# Jade Fleet broker settings. Installed as /etc/jade-fleet/fleet.env; restart after changes:
#   sudo systemctl restart jade-fleet

# Where phones and browsers connect
FLEET_BIND=0.0.0.0:8765
# Database, token file and (by default) the shared vault
FLEET_DATA=/var/lib/jade-fleet
# The shared vault folder (default: $FLEET_DATA/vault)
#FLEET_VAULT=/srv/jade-vault
# Fleet token. Leave empty to use the one made on first start: sudo -u jade jade-fleet token
#FLEET_TOKEN=

# All model compute runs on the Xavier (see xavier/README.md). Ollama there serves embeddings.
OLLAMA_URL=http://192.168.1.100:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# Index the vault's notes for vector search (1/0) and chunk size in characters
INDEX_VAULT=1
CHUNK_CHARS=1200

# Chat: llama-server on the Xavier (OpenAI-compatible, base URL ending in /v1)
LLM_URL=http://192.168.1.100:8080/v1
LLM_MODEL=gemma4-e2b-custom
LLM_TEMPERATURE=0.7
# WebSocket chat (/ws/DEVICE): notes put in the prompt, turns remembered, the system prompt
RAG_K=3
HISTORY_TURNS=8
#SYSTEM_PROMPT=You are Jade, an edge-hosted AI assistant.

# Ollaya on the Xavier: decision models such as laya (/ollaya/…)
OLLAYA_URL=http://192.168.1.100:11435
# Where /v1/systemone and /api/decide go: Ollaya (default) or Ollama 0.35+ (http://192.168.1.100:11434)
#DECIDE_URL=http://192.168.1.100:11435

# Vision service on the Xavier (YOLO / MobileNet on the DLA cores)
VISION_URL=http://192.168.1.100:8090

# Programs phones may run here, and the longest a run-and-return command may take (seconds)
FLEET_SHELLS=bash,sh,python3,node
EXEC_MAX=1800

# The browser client
FLEET_WEB=/usr/share/jade-fleet/web
# Log level: jade_fleet=info, jade_fleet=debug
FLEET_LOG=jade_fleet=info
